<!DOCTYPE html>
<html>
<head>
    <title>School Result Table</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        table {
            border-collapse: collapse;
            width: 80%;
            max-width: 800px;
            background-color: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        caption {
            font-size: 22px;
            font-weight: bold;
            padding: 12px;
            background-color: #2c3e50;
            color: white;
            caption-side: top;
        }

        thead {
            background-color: #34495e;
            color: white;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        th {
            font-weight: bold;
        }

        tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        tbody tr:hover {
            background-color: #d6eaf8;
            transition: 0.3s;
        }

        .grade-A {
            color: green;
            font-weight: bold;
        }

        .grade-B {
            color: orange;
            font-weight: bold;
        }
    </style>
</head>

<body>

<table>

    <caption>Class 10 Annual Examination Result 2026</caption>

    <thead>
        <tr>
            <th rowspan="2">Roll No</th>
            <th rowspan="2">Student Name</th>
            <th colspan="3">Marks Obtained</th>
            <th rowspan="2">Total</th>
            <th rowspan="2">Grade</th>
        </tr>
        <tr>
            <th>Maths</th>
            <th>Science</th>
            <th>English</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>101</td>
            <td>Rahul</td>
            <td>85</td>
            <td>78</td>
            <td>88</td>
            <td>251</td>
            <td class="grade-A">A</td>
        </tr>
        <tr>
            <td>102</td>
            <td>Sneha</td>
            <td>90</td>
            <td>92</td>
            <td>89</td>
            <td>271</td>
            <td class="grade-A">A+</td>
        </tr>
        <tr>
            <td>103</td>
            <td>Aman</td>
            <td>70</td>
            <td>65</td>
            <td>75</td>
            <td>210</td>
            <td class="grade-B">B</td>
        </tr>
    </tbody>

</table>

</body>
</html>
